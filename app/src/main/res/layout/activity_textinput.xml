<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA"
    tools:context=".TextInputActivity">

    <!-- 헤더: 뒤로가기 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center_vertical"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="30dp"
            android:layout_height="40dp"
            android:paddingStart="0dp"
            android:paddingEnd="1dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/chevron_left_thin"
            android:contentDescription="뒤로가기" />

    </LinearLayout>

    <!-- 스크롤 가능한 컨텐츠 영역 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 제목 텍스트 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="구체적인 증상과 나이,\n성별을 반드시 작성해주세요!"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:lineSpacingExtra="10dp"
                android:layout_marginBottom="30dp" />

            <!-- 텍스트 입력 필드 -->
            <EditText
                android:id="@+id/etSymptomInput"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:background="#FFFFFF"
                android:hint="증상을 입력해주세요!"
                android:textColorHint="#BDBDBD"
                android:textColor="#000000"
                android:textSize="17sp"
                android:padding="20dp"
                android:gravity="top"
                android:maxLines="10"
                android:inputType="textMultiLine"
                android:scrollbars="vertical"
                android:layout_marginBottom="15dp"
                android:fadeScrollbars="false" />

            <!-- 안내 텍스트 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="↓ 이렇게 입력하면 좋아요!\n주요 증상과 위치, 증상 발생 시점과 기간, 증상의 강도(0~10점) 등을 입력하면 더 정확해요"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#666666"
                android:lineSpacingExtra="5dp"
                android:layout_marginBottom="40dp" />

        </LinearLayout>

    </ScrollView>

    <!-- 다음 버튼 (하단 고정) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="15dp"
        android:paddingBottom="20dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="다음"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_border"
            android:gravity="center" />

    </LinearLayout>

</LinearLayout>