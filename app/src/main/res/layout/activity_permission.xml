<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff">

    <!-- 반투명 회색 오버레이 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC808080" />

    <!-- 권한 설정 다이얼로그 박스 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="0dp"
        android:background="#ffffff"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 타이틀 텍스트 -->
        <TextView
            android:id="@+id/permission_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/permission_title"
            android:textColor="#000000"
            android:textSize="25sp"
            android:textStyle="bold" />

        <!-- 스크롤뷰 (권한 항목들) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 위치 권한 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- 왼쪽 아이콘 -->
                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/p_n"
                        android:contentDescription="@string/permission_location_desc"
                        android:scaleType="centerInside"
                        android:layout_marginEnd="16dp" />

                    <!-- 오른쪽 텍스트 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/permission_location_title"
                            android:textColor="#000000"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/permission_location_detail"
                            android:textColor="#999999"
                            android:textSize="18sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 알림 권한 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- 왼쪽 아이콘 -->
                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/p_a"
                        android:contentDescription="@string/permission_notification_desc"
                        android:scaleType="centerInside"
                        android:layout_marginEnd="16dp" />

                    <!-- 오른쪽 텍스트 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/permission_notification_title"
                            android:textColor="#000000"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/permission_notification_detail"
                            android:textColor="#999999"
                            android:textSize="18sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 음성 권한 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- 왼쪽 아이콘 -->
                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/p_m"
                        android:contentDescription="@string/permission_voice_desc"
                        android:scaleType="centerInside"
                        android:layout_marginEnd="16dp" />

                    <!-- 오른쪽 텍스트 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/permission_voice_title"
                            android:textColor="#000000"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/permission_voice_detail"
                            android:textColor="#999999"
                            android:textSize="18sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 카메라/사진 권한 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- 왼쪽 아이콘 -->
                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/p_c"
                        android:contentDescription="@string/permission_camera_desc"
                        android:scaleType="centerInside"
                        android:layout_marginEnd="16dp" />

                    <!-- 오른쪽 텍스트 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/permission_camera_title"
                            android:textColor="#000000"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/permission_camera_detail"
                            android:textColor="#999999"
                            android:textSize="18sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- 확인 버튼 -->
        <Button
            android:id="@+id/close_button"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/btn_border"
            android:backgroundTint="#000000"
            android:text="@string/permission_confirm"
            android:textColor="#FFFFFF"
            android:textSize="20dp" />

    </LinearLayout>

</FrameLayout>