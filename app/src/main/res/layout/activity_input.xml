<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF"
    tools:context=".InputActivity">

    <!-- 헤더: 뒤로가기 + 제목 텍스트 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="32dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="30dp"
            android:layout_height="40dp"
            android:paddingStart="0dp"
            android:paddingEnd="1dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/chevron_left_thin"
            android:contentDescription="뒤로가기" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center" />

        <View
            android:layout_width="40dp"
            android:layout_height="1dp" />

    </LinearLayout>

    <!-- 부제목 텍스트 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="어떤 증상이 있으신가요?\n원하시는 입력 방식을 선택해주세요!"
        android:textSize="24sp"
        android:textColor="#000000"
        android:textStyle="bold"
        android:lineSpacingExtra="8dp"
        android:layout_marginBottom="40dp" />

    <!-- 입력 방식 선택 섹션 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="24dp">

        <!-- 텍스트 입력 옵션 (이미지 왼쪽, 높이 160dp) -->
        <LinearLayout
            android:id="@+id/btnTextInput"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/btn_border"
            android:focusable="true"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground">

            <!-- 텍스트 입력 아이콘 (왼쪽) -->
            <ImageView
                android:id="@+id/ivTextIcon"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/text"
                android:contentDescription="텍스트 입력"
                android:scaleType="centerInside"
                android:layout_marginRight="25dp" />

            <!-- 텍스트 레이블 -->
            <TextView
                android:id="@+id/tvTextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="텍스트로 입력하기"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#000000" />

        </LinearLayout>

        <!-- 음성 입력 옵션 (이미지 왼쪽, 높이 160dp) -->
        <LinearLayout
            android:id="@+id/btnVoiceInput"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/btn_border"
            android:focusable="true"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground">

            <!-- 음성 입력 아이콘 (왼쪽) -->
            <ImageView
                android:id="@+id/ivVoiceIcon"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/voice"
                android:contentDescription="음성 입력"
                android:scaleType="centerInside"
                android:layout_marginRight="25dp" />

            <!-- 음성 레이블 -->
            <TextView
                android:id="@+id/tvVoiceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="음성으로 입력하기"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#000000" />

        </LinearLayout>

    </LinearLayout>

    <!-- 다음 버튼 (위로 올려짐) -->
    <Button
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="다음"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/btn_border"
        android:gravity="center"
        android:layout_marginTop="0dp" />

</LinearLayout>