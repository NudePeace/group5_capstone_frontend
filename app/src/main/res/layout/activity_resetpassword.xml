<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF"
    tools:context=".ResetpasswordActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="32dp">

        <!-- 뒤로가기 -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="30dp"
            android:layout_height="40dp"
            android:paddingStart="0dp"
            android:paddingEnd="1dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/chevron_left_thin" />

        <!-- 왼쪽 공간 -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="0.6" />

        <!-- 비밀번호 재설정 텍스트 -->
        <TextView
            android:text="@string/title_find_password"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- 새 비밀번호 -->
    <TextView
        android:text="@string/new_password_label"
        android:textSize="20sp"
        android:layout_marginRight="150dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <EditText
        android:id="@+id/etNewPassword"
        android:hint="@string/new_password_hint"
        android:inputType="textPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="@android:drawable/edit_text" />

    <!-- 비밀번호 확인 -->
    <TextView
        android:text="@string/new_password_confirm_label"
        android:textSize="20sp"
        android:layout_marginRight="110dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <EditText
        android:id="@+id/etConfirmPassword"
        android:hint="@string/new_password_confirm_hint"
        android:inputType="textPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="@android:drawable/edit_text" />

    <!-- 입력 완료 버튼 -->
    <Button
        android:id="@+id/btnComplete"
        android:text="@string/submit_button"
        android:textSize="20sp"
        android:textColor="#BDBDBD"
        android:layout_marginTop="24dp"
        android:padding="10dp"
        android:background="@drawable/btn_border"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>